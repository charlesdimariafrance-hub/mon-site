{
  "rewrites": [
    {
      "source": "/fd/:path*",
      "destination": "http://folkadanse.free.fr/:path*"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}