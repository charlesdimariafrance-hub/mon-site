{
  "rewrites": [
    {
      "source": "/fd/:path*",
      "destination": "http://folkadanse.free.fr/:path*"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/villa-adelina.html,",
      "destination": "/villa-adelina.html",
      "permanent": false
    },
    {
      "source": "/villa-adelina.html.",
      "destination": "/villa-adelina.html",
      "permanent": false
    },
    {
      "source": "/villa-adelina",
      "destination": "/villa-adelina.html",
      "permanent": false
    }
  ]
}